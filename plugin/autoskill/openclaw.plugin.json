{
  "id": "autoskill",
  "name": "AutoSkill Manager",
  "description": "Captures redacted OpenClaw events, spools them locally, forwards to the SkillKernel sidecar, and optionally injects cached runtime skill-context hints.",
  "activation": {
    "onStartup": true
  },
  "hooks": "hooks",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "sidecarUrl": { "type": "string" },
      "ingestToken": { "type": "string" },
      "spoolDir": { "type": "string" },
      "workspaceId": { "type": "string" },
      "replayBatchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
      "maxSpoolBytes": { "type": "integer", "minimum": 1024 },
      "captureRawConversation": { "type": "boolean" },
      "rawSpoolEncryptionKey": { "type": "string" },
      "rawSpoolKeyId": { "type": "string" },
      "rawSpoolRetentionMs": { "type": "integer", "minimum": 1000 },
      "compatibilityHandshake": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": { "type": "integer", "minimum": 25, "maximum": 5000 },
          "cacheTtlMs": { "type": "integer", "minimum": 0 }
        }
      },
      "runtimeContextBroker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 25, "maximum": 1000 },
          "maxTokens": { "type": "integer", "minimum": 50, "maximum": 1000 },
          "failSoft": { "type": "boolean" }
        }
      },
      "runtimeToolBoundary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "blockOnHighRisk": { "type": "boolean" }
        }
      }
    }
  }
}
