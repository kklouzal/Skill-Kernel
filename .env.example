AUTOSKILL_POSTGRES_PASSWORD=change-me
AUTOSKILL_INGEST_TOKEN=change-me
AUTOSKILL_CONTROL_TOKEN=change-me
AUTOSKILL_WEB_ADMIN_TOKEN=change-me

AUTOSKILL_WORKSPACE_ID=local
SKILLKERNEL_WORKSPACE_ROOT=./.skillkernel/workspace
OPENCLAW_HOST_DIR=./.skillkernel/openclaw

AUTOSKILL_MODE=autonomous_guarded
AUTOSKILL_RUNTIME_CONTEXT_BROKER_ENABLED=false

# Bring your own OpenAI-compatible LLM endpoint. On Linux Docker hosts,
# host.docker.internal is mapped to the host gateway by docker-compose.yml.
AUTOSKILL_LLM_API_BASE_URL=http://host.docker.internal:18080/v1
AUTOSKILL_LLM_API_KEY=change-me

# Bring your own OpenAI-compatible embedding endpoint. pgvector stores vectors;
# this endpoint generates them.
AUTOSKILL_EMBEDDING_PROVIDER=openai_compatible
AUTOSKILL_EMBEDDING_API_BASE_URL=http://host.docker.internal:18081/v1
AUTOSKILL_EMBEDDING_API_KEY=change-me
AUTOSKILL_EMBEDDING_MODEL=Qwen3-Embedding-4B-Q8_0.gguf
AUTOSKILL_EMBEDDING_DIM=1536
AUTOSKILL_EMBEDDING_TIMEOUT_SECONDS=30

SKILLKERNEL_CORE_BIND=127.0.0.1
SKILLKERNEL_CORE_PORT=8765
SKILLKERNEL_OBSERVATORY_BIND=127.0.0.1
SKILLKERNEL_OBSERVATORY_PORT=8757
SKILLKERNEL_POSTGRES_BIND=127.0.0.1
SKILLKERNEL_POSTGRES_PORT=55432
