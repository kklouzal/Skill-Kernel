server {
  listen ${SKILLKERNEL_OBSERVATORY_PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location = /admin {
    return 308 /admin/;
  }

  location /admin/api/ {
    proxy_pass ${SKILLKERNEL_CORE_UPSTREAM}/admin/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /admin/live {
    proxy_pass ${SKILLKERNEL_CORE_UPSTREAM}/admin/live;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /admin/live-sse {
    proxy_pass ${SKILLKERNEL_CORE_UPSTREAM}/admin/live-sse;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /admin/ {
    try_files $uri $uri/ /admin/index.html;
  }
}
